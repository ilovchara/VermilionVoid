---
import BaseLayout from "@/layouts/BaseLayout.astro"
import SiteHeader from "@/components/site-header.astro"
import { Footer } from "@/components/footer"

const title = "404 · 页面未找到 | 朱墨留白"
const description = "施工中,在未来会开通的ฅʕ•̫͡•ʔฅ"
const destinations = [
  { label: "时间线", description: "沿着时间，翻翻旧文章", href: "/timeline/" },
  { label: "偶得", description: "读一点日常的零碎想法", href: "/thoughts/" },
  { label: "专题", description: "沿着一个问题，慢慢深入", href: "/studies/" },
]
---

<BaseLayout {title} {description} robots="noindex, follow" fontProfile="interface">
  <SiteHeader />
  <main class="not-found" data-pagefind-ignore>
    <section class="not-found-hero" aria-labelledby="not-found-title">
      <div class="not-found-copy">
        <p class="not-found-eyebrow"><span aria-hidden="true"></span>404 / PAGE NOT FOUND</p>
        <h1 id="not-found-title">施工中，<br />在未来会开通的ฅʕ•̫͡•ʔฅ</h1>
        <p class="not-found-description">
          还没有那么多精力完成，<br class="desktop-break" />也可能还没来得及写下。<br />不如换个方向，继续逛逛。
        </p>
        <a class="home-link" href="/">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m12 19-7-7 7-7M5 12h14" />
          </svg>
          返回首页
        </a>
      </div>

      <div class="not-found-art">
        <img src="/404.png" width="3698" height="2500" alt="青绿色背景上的施工路障、安全帽和黄色路牌" fetchpriority="high" decoding="async" />
        <div class="art-caption" aria-hidden="true">
          <span class="art-code">404</span>
          <span class="art-note">施工中 · 未来可期</span>
        </div>
      </div>
    </section>

    <nav class="not-found-explore" aria-label="继续探索">
      <p class="explore-label">别处还有风景</p>
      <div class="explore-links">
        {destinations.map((destination) => (
          <a class="explore-link" href={destination.href}>
            <span>
              <span class="destination-title">{destination.label}</span>
              <span class="destination-description">{destination.description}</span>
            </span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7M7 7h10v10" />
            </svg>
          </a>
        ))}
      </div>
    </nav>
  </main>
  <Footer />
</BaseLayout>

<style>
  .not-found {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    padding: clamp(8rem, 15vh, 11rem) 1.5rem 4rem;
  }

  .not-found-hero {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .not-found-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.75rem;
    color: var(--muted-foreground);
    font: 0.6875rem var(--font-mono);
    letter-spacing: 0.12em;
  }

  .not-found-eyebrow > span {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--primary);
  }

  h1 {
    font-family: var(--font-serif-cn);
    font-size: clamp(2.25rem, 4.2vw, 3.5rem);
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.04em;
  }

  .not-found-description {
    margin-top: 1.5rem;
    color: var(--content-secondary);
    font-size: 0.9375rem;
    line-height: 1.95;
  }

  .home-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 2.875rem;
    margin-top: 2rem;
    padding: 0.75rem 1.375rem;
    border-radius: 0.5rem;
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: 0.875rem;
    font-weight: 600;
    transition: opacity 180ms;
  }

  .home-link:hover { opacity: 0.85; }
  a:focus-visible { outline: 2px solid var(--ring); outline-offset: 5px; }

  .not-found-art {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1.15;
    border-radius: 1.25rem;
    background: #75c9ca;
    isolation: isolate;
  }

  .not-found-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
  }

  .art-caption {
    position: absolute;
    inset: 1.5rem 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #164e52;
  }

  .art-code {
    font: 500 clamp(4rem, 8vw, 7rem)/1 var(--font-mono);
    letter-spacing: -0.08em;
  }

  .art-note { margin-top: 0.5rem; font-size: 0.6875rem; letter-spacing: 0.16em; }

  .not-found-explore {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .explore-label { color: var(--muted-foreground); font-size: 0.75rem; }
  .explore-links { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem; margin-top: 0.5rem; }
  .explore-link { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 0.875rem; }
  .destination-title { display: block; font-size: 0.9375rem; transition: color 180ms; }
  .destination-description { display: block; margin-top: 0.375rem; color: var(--muted-foreground); font-size: 0.75rem; line-height: 1.6; }
  .explore-link svg { flex-shrink: 0; color: var(--muted-foreground); transition: color 180ms; }
  .explore-link:hover .destination-title, .explore-link:hover svg { color: var(--primary); }

  @media (max-width: 767px) {
    .not-found { padding-top: 7rem; padding-bottom: 3rem; }
    .not-found-hero { grid-template-columns: 1fr; gap: 2.5rem; }
    .not-found-eyebrow { margin-bottom: 1rem; }
    .not-found-description { margin-top: 1rem; }
    .desktop-break { display: none; }
    .home-link { margin-top: 1.5rem; }
    .not-found-art { aspect-ratio: 1.4; }
    .art-caption { top: 1rem; }
    .art-code { font-size: clamp(3.5rem, 14vw, 6rem); }
    .art-note { margin-top: 0.25rem; font-size: 0.625rem; }
    .explore-links { grid-template-columns: 1fr; gap: 0; }
    .explore-link + .explore-link { border-top: 1px solid var(--border); }
  }
</style>
